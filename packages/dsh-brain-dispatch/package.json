    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh-monorepo/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../dsh-monorepo/vendor/schemastery",
    "@deepseek-ai/dsh-agent": "link:../../../dsh-monorepo/packages/core/agent",
    "@deepseek-ai/dsh-tools": "link:../../../dsh-monorepo/packages/core/tools",
    "dsh-brain-conduct": "link:../dsh-conduct",
    "dsh-brain-memory": "link:../dsh-memory"
  }
}
